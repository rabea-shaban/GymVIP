# Environment & Port
NODE_ENV=production
PORT=5000

# Database Connection (MySQL)
DATABASE_URL="mysql://gymvip_user:strong_password@localhost:3306/gymvip"

# Authentication Security (Must be at least 16 characters in production)
JWT_SECRET="replace_with_strong_random_secret_at_least_16_chars"
JWT_EXPIRES_IN="7d"

# CORS & Domain Configuration
FRONTEND_URL="https://app.gymvip.eg"
ALLOWED_ORIGINS="https://app.gymvip.eg,https://gymvip.eg"
